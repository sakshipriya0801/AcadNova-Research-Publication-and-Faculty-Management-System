# Frontend environment configuration (example)
# Copy this file to .env and fill in real values later.

# Base URL for the backend API (used by axios services).
#
# Leave this EMPTY in development: requests are then relative (same-origin) and
# the Vite dev proxy forwards `/api` to FastAPI on http://127.0.0.1:8000. This
# works regardless of which port Vite uses (5173, 5174, ...).
#
# Set it only when the API is served from a different origin in production,
# e.g. VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
