# Backend environment configuration (example)
# Copy this file to .env and fill in real values.

APP_NAME=AcadNova
APP_ENV=development
APP_DEBUG=true

# API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Browser CORS origins (comma-separated). Development default covers the Vite
# dev server on 5173 and its automatic fallback 5174. Set explicit origins in
# production instead of the "*" wildcard.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# MongoDB
# Local development:
#   MONGODB_URI=mongodb://localhost:27017
# MongoDB Atlas (SRV) — replace the placeholders and put the real value in
# backend/.env (which is git-ignored). Never commit real credentials.
#   MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
# The database name is always taken from MONGODB_DATABASE below.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=research_faculty_db
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# JWT Authentication
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# New faculty self-registrations require administrator approval before sign-in.
REQUIRE_REGISTRATION_APPROVAL=true

# External scholarly sources (public APIs; leave blank for defaults)
CROSSREF_API_URL=https://api.crossref.org
CROSSREF_TIMEOUT_SECONDS=10

PUBMED_API_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
PUBMED_TIMEOUT_SECONDS=10
# Optional — the app works without these for low-volume development use.
PUBMED_API_KEY=
PUBMED_EMAIL=

# ORCID (public API works without credentials; OAuth tokens are NOT handled yet)
ORCID_API_URL=https://pub.orcid.org/v3.0
ORCID_TIMEOUT_SECONDS=10
# Optional — reserved for future authenticated ORCID features.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# Scopus / Elsevier (requires an institutional API key).
# Obtain a free API key from the Elsevier Developer Portal
# (https://dev.elsevier.com) by registering an "API Key" for the Scopus Search
# API / Abstract Retrieval API. Set it here as SCOPUS_API_KEY.
# Search supports query, title, DOI, author name, and Scopus Author ID.
SCOPUS_API_URL=https://api.elsevier.com/content
SCOPUS_TIMEOUT_SECONDS=10
SCOPUS_API_KEY=

# Web of Science / Clarivate (requires an institutional API key)
WEB_OF_SCIENCE_API_URL=https://api.clarivate.com/apis/wos-starter/v1
WEB_OF_SCIENCE_TIMEOUT_SECONDS=10
WEB_OF_SCIENCE_API_KEY=

# Publication document storage
DOCUMENT_STORAGE_DIR=./storage/documents
MAX_DOCUMENT_SIZE_MB=20

# AI/RAG foundation (Steps 15A/15C). Optional — the application runs without it.
# Providers are blank by default so no paid service is required. "test" is a
# deterministic embedding provider for development/testing only; "openai" needs
# the API key below. Embedding and LLM models are configured separately.
RAG_ENABLED=true
RAG_EMBEDDING_PROVIDER=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_BATCH_SIZE=32
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MAX_TOP_K=20
RAG_MAX_QUERY_LENGTH=2000
RAG_MIN_RELEVANCE_SCORE=0.0
RAG_MAX_CONTEXT_WORDS=3000
RAG_LLM_PROVIDER=
RAG_LLM_MODEL=
RAG_LLM_TEMPERATURE=0.0
RAG_OPENAI_API_URL=https://api.openai.com/v1
RAG_OPENAI_API_KEY=
RAG_OPENAI_TIMEOUT_SECONDS=30
